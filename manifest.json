{
  "manifest_version": 3,
  "name": "Shopee Affiliate Link",
  "description": "Generate Shopee Affiliate short links by driving the Shopee Affiliate page UI.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://affiliate.shopee.vn/*",
    "ws://54.151.162.201:8083/*",
    "ws://myoupip.com:8083/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://affiliate.shopee.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://affiliate.shopee.vn/*"
      ]
    }
  ]
}
